# .env.example
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Next.js and prisma.config.ts both read .env.local. Every value here is a placeholder.

# ── Public (sent to the browser; validated by src/lib/env.ts) ──
# Supabase project URL and anon key: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server only (never sent to the browser; validated by src/lib/env.server.ts) ──
# Pooled connection used by the app at runtime: Supavisor transaction mode, port 6543.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:6543/postgres?pgbouncer=true
# Direct (non-pooled) connection used by the Prisma CLI for migrations, port 5432.
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:5432/postgres
# "true" turns on the open-weight model for spreadsheet import. "false" uses smart import only.
AI_IMPORT_ENABLED=true

# Dev-only demo sign-in (D-024). "true" lets `npm run dev` show signed-in pages without Supabase,
# as a demo user. Ignored outside `next dev`; `npm run build` fails if it is "true".
# Never set this in Vercel or any shared environment.
DEV_DEMO_AUTH=false

# ── Tests only (npm run test:db) ──
# A separate, empty, migrated database whose name contains "test". Never the app's database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventops_test
