// prisma/schema.prisma
//
// EventOps data model. Rules from AGENTS.md that shape this file:
// - Money is Decimal (PHP), never Float.
// - Every event-owned table carries eventId and an index on it; every query filters by eventId.
// - Users live in Supabase Auth (auth.users). userId columns hold that uuid and have no
//   Prisma relation, because Prisma does not manage the auth schema.
// - Status transitions (event, RSVP, quote, payment, import) are enforced in the domain layer,
//   not here. The enums only list the allowed values.
// - JSON columns are validated with Zod on every read and write.
// - Business defaults (cost per head, accessible-seat ratio, vehicle capacity) are NOT set here.
//   They belong to the Assumptions value object, so there is a single source of truth.
// - Event health is computed on demand and is not stored.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not in this file.
datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum MemberRole {
  OWNER
  COORDINATOR
  VIEWER

  @@map("member_role")
}

enum EventStatus {
  DRAFT
  PLANNING
  LIVE
  COMPLETED
  CANCELLED

  @@map("event_status")
}

enum RsvpStatus {
  INVITED
  CONFIRMED
  DECLINED
  MAYBE

  @@map("rsvp_status")
}

enum RequirementType {
  MOBILITY_ASSISTANCE
  ACCESSIBLE_SEATING
  ACCESSIBLE_ENTRANCE
  ACCESSIBLE_RESTROOM
  SIGN_LANGUAGE
  CAPTIONING
  DIETARY
  OTHER

  @@map("requirement_type")
}

enum SupplierCategory {
  VENUE
  CATERING
  TRANSPORT
  PHOTO_VIDEO
  DECOR_FLORALS
  ENTERTAINMENT
  ATTIRE_BEAUTY
  PRINTING
  OTHER

  @@map("supplier_category")
}

enum QuoteStatus {
  REQUESTED
  RECEIVED
  ACCEPTED
  REJECTED

  @@map("quote_status")
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PARTIALLY_PAID
  PAID

  @@map("payment_status")
}

enum BudgetCategory {
  VENUE
  CATERING
  TRANSPORT
  PHOTO_VIDEO
  DECOR_FLORALS
  ENTERTAINMENT
  ATTIRE_BEAUTY
  PRINTING
  OTHER

  @@map("budget_category")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priority")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

// The operational areas an impact or a task can point to.
enum EventArea {
  ATTENDEES
  SEATING
  ACCESSIBILITY
  BUDGET
  CATERING
  SUPPLIERS
  TRANSPORT
  VOLUNTEERS
  TASKS
  TIMELINE

  @@map("event_area")
}

enum Severity {
  CRITICAL
  NEEDS_ATTENTION
  INFO
  PASSED

  @@map("severity")
}

enum ImportStatus {
  UPLOADED
  EXTRACTING
  READY_FOR_REVIEW
  CONFIRMED
  DISCARDED
  FAILED

  @@map("import_status")
}

// Where an extraction came from. The UI labels these "model" and "smart import".
// The heuristic extractor is never called AI.
enum ExtractionSource {
  MODEL
  SMART_IMPORT

  @@map("extraction_source")
}

// ─────────────────── Events, members, assumptions ───────────────────

// Mirror of the Supabase Auth user, created on first sign-in. Used only to show names.
model Profile {
  id          String   @id @db.Uuid
  displayName String
  email       String   @unique
  createdAt   DateTime @default(now())

  members EventMember[]

  @@map("profiles")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  // Human-readable ID, for example EVT-2026-0001. Generated by the use case.
  reference   String      @unique
  name        String
  description String?
  venue       String?
  startsAt    DateTime
  endsAt      DateTime?
  // Venue capacity. Compared with expectedAttendees by the seating rule.
  capacity    Int?
  // Planning number. Not the count of Attendee records. Changing it produces estimates.
  expectedAttendees Int @default(0)
  status      EventStatus @default(DRAFT)
  createdById String      @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Atomic counters for readable IDs (ATT-0184, SUP-0012). Incremented inside the creating transaction.
  nextAttendeeNumber Int @default(1)
  nextSupplierNumber Int @default(1)

  assumptions      EventAssumptions?
  members          EventMember[]
  attendees        Attendee[]
  accessibilityRequirements AccessibilityRequirement[]
  accessibilityResources    AccessibilityResource[]
  suppliers        Supplier[]
  supplierPayments SupplierPayment[]
  budgetAllocations BudgetAllocation[]
  budgetItems      BudgetItem[]
  tasks            Task[]
  volunteerRoles   VolunteerRole[]
  volunteers       Volunteer[]
  timelineItems    TimelineItem[]
  impactEvents     ImpactEvent[]
  importSessions   ImportSession[]
  auditLogs        AuditLog[]

  @@index([createdById])
  @@index([status, startsAt])
  @@map("events")
}

// Editable planning assumptions. Their values are copied onto each ImpactItem when it is created.
// No column defaults on purpose: the defaults live in the Assumptions value object.
model EventAssumptions {
  eventId             String  @id @db.Uuid
  // PHP per head, used by the catering cost rule.
  costPerHead         Decimal @db.Decimal(12, 2)
  // Share of expected attendees who need accessible seating, from 0 to 1.
  accessibleSeatRatio Decimal @db.Decimal(5, 4)
  // Seats per vehicle, used by the transport rule.
  vehicleCapacity     Int
  // Attendees per volunteer, used by the volunteer coverage rule.
  attendeesPerVolunteer Int
  updatedAt           DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_assumptions")
}

model EventMember {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now())

  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile       Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_members")
}

// ─────────────────────── Attendees and accessibility ───────────────────────

model Attendee {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @db.Uuid
  // Per-event sequence behind the readable ID, for example ATT-0184.
  number      Int
  name        String
  email       String?
  phone       String?
  rsvpStatus  RsvpStatus @default(INVITED)
  category    String?
  plusOnes    Int        @default(0)
  dietaryNeeds String?
  notes       String?
  // Set by check-in on the day of the event.
  checkedInAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  event        Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requirements AccessibilityRequirement[]

  @@unique([eventId, number])
  @@index([eventId, rsvpStatus])
  @@index([eventId, name])
  @@map("attendees")
}

// A need that belongs to one attendee or one volunteer (exactly one of the two).
// Prisma cannot express that rule, so the use case enforces it.
model AccessibilityRequirement {
  id          String          @id @default(uuid()) @db.Uuid
  eventId     String          @db.Uuid
  attendeeId  String?         @db.Uuid
  volunteerId String?         @db.Uuid
  type        RequirementType
  notes       String?
  createdAt   DateTime        @default(now())

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee  Attendee?  @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  volunteer Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([eventId, type])
  @@index([attendeeId])
  @@index([volunteerId])
  @@map("accessibility_requirements")
}

// What the event has available, one row per type.
// Example: ACCESSIBLE_SEATING available = 6. "Configured" means available > 0.
model AccessibilityResource {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @db.Uuid
  type      RequirementType
  available Int             @default(0)
  notes     String?
  updatedAt DateTime        @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, type])
  @@map("accessibility_resources")
}

// ───────────────────────── Suppliers and budget ─────────────────────────

model Supplier {
  id             String           @id @default(uuid()) @db.Uuid
  eventId        String           @db.Uuid
  // Per-event sequence behind the readable ID, for example SUP-0012.
  number         Int
  name           String
  category       SupplierCategory
  contactName    String?
  email          String?
  phone          String?
  quoteAmount    Decimal?         @db.Decimal(12, 2)
  quoteStatus    QuoteStatus      @default(REQUESTED)
  depositAmount  Decimal?         @db.Decimal(12, 2)
  // Changed only through domain status transitions.
  paymentStatus  PaymentStatus    @default(UNPAID)
  dueDate        DateTime?
  // Null until the supplier confirms. Read by the supplier confirmations health check.
  confirmedAt    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments    SupplierPayment[]
  budgetItems BudgetItem[]
  tasks       Task[]

  @@unique([eventId, number])
  @@index([eventId, category])
  @@index([eventId, quoteStatus])
  @@map("suppliers")
}

model SupplierPayment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  supplierId String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  paidAt     DateTime
  note       String?
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([supplierId])
  @@map("supplier_payments")
}

// Planned amount per category.
model BudgetAllocation {
  id        String         @id @default(uuid()) @db.Uuid
  eventId   String         @db.Uuid
  category  BudgetCategory
  allocated Decimal        @db.Decimal(12, 2)
  updatedAt DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, category])
  @@map("budget_allocations")
}

// A budget line. Remaining budget and over-budget status are computed by computeBudgetSummary.
model BudgetItem {
  id              String         @id @default(uuid()) @db.Uuid
  eventId         String         @db.Uuid
  supplierId      String?        @db.Uuid
  category        BudgetCategory
  description     String
  estimatedAmount Decimal        @db.Decimal(12, 2)
  committedAmount Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([eventId, category])
  @@index([supplierId])
  @@map("budget_items")
}

// ───────────────────────────── Tasks ─────────────────────────────

model Task {
  id                String       @id @default(uuid()) @db.Uuid
  eventId           String       @db.Uuid
  title             String
  description       String?
  assigneeMemberId  String?      @db.Uuid
  dueDate           DateTime?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TODO)
  // A task relates to a supplier, an area, both, or neither.
  relatedSupplierId String?      @db.Uuid
  relatedArea       EventArea?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee        EventMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  relatedSupplier Supplier?    @relation(fields: [relatedSupplierId], references: [id], onDelete: SetNull)

  @@index([eventId, status, dueDate])
  @@index([eventId, relatedArea])
  @@index([assigneeMemberId])
  @@index([relatedSupplierId])
  @@map("tasks")
}

// ─────────────── Volunteers and timeline (Tier 2) ───────────────

model VolunteerRole {
  id            String @id @default(uuid()) @db.Uuid
  eventId       String @db.Uuid
  name          String
  // People needed in this role. Coverage reads as assigned / required, for example Usher 2/3.
  requiredCount Int

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteers Volunteer[]

  @@unique([eventId, name])
  @@map("volunteer_roles")
}

model Volunteer {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  roleId      String?   @db.Uuid
  name        String
  email       String?
  phone       String?
  shiftStart  DateTime?
  shiftEnd    DateTime?
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event        Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role         VolunteerRole?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  requirements AccessibilityRequirement[]

  @@index([eventId])
  @@index([roleId])
  @@map("volunteers")
}

// One row of the run-of-show.
model TimelineItem {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@map("timeline_items")
}

// ───────────────────────────── Impact ─────────────────────────────

// One applied change and what it triggered. Preview runs are not stored.
model ImpactEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  changedById String   @db.Uuid
  // Validated by Zod on read and write (a discriminated union of change kinds).
  changeType  String
  before      Json
  after       Json
  createdAt   DateTime @default(now())

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items ImpactItem[]

  @@index([eventId, createdAt])
  @@map("impact_events")
}

model ImpactItem {
  id              String    @id @default(uuid()) @db.Uuid
  impactEventId   String    @db.Uuid
  eventId         String    @db.Uuid
  // Id of the rule that produced it, from impact/domain/registry.ts.
  ruleId          String
  area            EventArea
  severity        Severity
  message         String
  reason          String
  // True when the item comes from the planning number rather than from records.
  isEstimate      Boolean
  // Snapshot of the assumptions used, copied from EventAssumptions. Validated by Zod.
  assumptionsUsed Json
  linkedRoute     String
  createdAt       DateTime  @default(now())

  impactEvent ImpactEvent @relation(fields: [impactEventId], references: [id], onDelete: Cascade)

  @@index([impactEventId])
  @@index([eventId, severity])
  @@map("impact_items")
}

// ───────────────────────────── Import ─────────────────────────────

model ImportSession {
  id               String            @id @default(uuid()) @db.Uuid
  eventId          String            @db.Uuid
  createdById      String            @db.Uuid
  status           ImportStatus      @default(UPLOADED)
  // Original name is for display only. The stored object uses storagePath, a generated name.
  originalFileName String
  mimeType         String
  sizeBytes        Int
  storagePath      String            @unique
  extractionSource ExtractionSource?
  // Extracted data and validation findings. Untrusted until Zod and business validation pass.
  extracted        Json?
  validationReport Json?
  errorMessage     String?
  createdAt        DateTime          @default(now())
  confirmedAt      DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("import_sessions")
}

// ───────────────────────────── Audit ─────────────────────────────

// Append-only. Written by writeAudit in the same transaction as the change. Never updated.
// Do not store guest names, phones or emails in before/after beyond what the change needs.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, entityType, entityId])
  @@map("audit_logs")
}
