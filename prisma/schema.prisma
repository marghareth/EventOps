// prisma/schema.prisma
//
// EventOps data model. B0-08 Database Foundation: users, events and event members; B1-11 adds the
// audit log; B2-01 adds attendees; B3-01 adds accessibility requirements and resources; B4 adds
// suppliers, quotes and payments; B5-F01 and B5-F02 add budget categories and budget items.
// Other tables (tasks, ...) are added by their own batch tasks,
// following docs/DECISIONS.md (D-002, D-003) and docs/DATA_MODEL.md.
//
// Ground rules:
// - Money is Decimal (PHP), never Float.
// - Every event-owned table carries eventId and an index that starts with it; every query
//   filters by eventId.
// - Links between two event-owned rows are composite foreign keys on (eventId, id), so the
//   database rejects links across events (D-002). Event-owned parents carry
//   @@unique([eventId, id]) for this.
// - Users live in Supabase Auth (auth.users). User mirrors that row by id, created on first
//   sign-in. There is no foreign key to the auth schema, because Prisma does not manage it.
// - Status transitions are enforced in the domain layer. Enums only list the allowed values.
// - CHECK constraints Prisma cannot express are written by hand in the migration SQL and listed
//   above the model they guard. Prisma does not diff CHECK constraints, so later migrations keep
//   them.
// - Business defaults belong to domain value objects, not column defaults.
// - Event health is computed on demand and is not stored.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and src/lib/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum MemberRole {
  OWNER
  COORDINATOR
  VIEWER

  @@map("member_role")
}

enum EventStatus {
  DRAFT
  PLANNING
  LIVE
  COMPLETED
  CANCELLED

  @@map("event_status")
}

// An attendee's answer to the invitation (D-042). New attendees start as PENDING (set by the domain,
// not by a column default).
enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE

  @@map("rsvp_status")
}

// What an attendee needs (B3-01, D-056). The canonical list, labels and meanings live in
// src/modules/events/accessibility/domain/requirement-type.ts (B3-02, D-057); a test keeps the two
// equal. Dietary needs are not here: they stay on the attendee (D-047).
enum AccessibilityRequirementType {
  MOBILITY_ASSISTANCE
  ACCESSIBLE_SEATING
  STEP_FREE_ENTRANCE
  ACCESSIBLE_RESTROOM
  SIGN_LANGUAGE
  CAPTIONING
  OTHER

  @@map("accessibility_requirement_type")
}

// How firmly a requirement must be met (D-057). REQUIRED is the domain default.
enum RequirementPriority {
  REQUIRED
  PREFERRED
  INFORMATIONAL

  @@map("requirement_priority")
}

// What the event can provide (B3-01, D-056). Canonical list in
// src/modules/events/accessibility/domain/resource.ts.
enum AccessibilityResourceType {
  ACCESSIBLE_SEATS
  ACCESSIBLE_ENTRANCE
  RAMP_OR_ELEVATOR
  ACCESSIBLE_RESTROOM
  CAPTIONING
  SIGN_LANGUAGE

  @@map("accessibility_resource_type")
}

// Whether a resource is in place (D-056). No row for a type means "Not set up".
enum ResourceStatus {
  NOT_AVAILABLE
  ARRANGING
  AVAILABLE

  @@map("resource_status")
}

// ───────────────────────────── Users ─────────────────────────────

// Mirror of the Supabase Auth user (same id), created on first sign-in. Used to show names and
// to link members and event creators. See docs/DECISIONS.md, D-009.
model User {
  id          String   @id @db.Uuid
  displayName String
  email       String   @unique
  createdAt   DateTime @default(now())

  memberships   EventMember[]
  createdEvents Event[]
  auditLogs     AuditLog[]

  @@map("users")
}

// ───────────────────────────── Events ─────────────────────────────

// Ownership (D-022): every event has at least one OWNER membership. A deferred constraint trigger
// (migration 20261011090000_event_ownership) checks it at commit, so create the event and its OWNER
// membership in the same transaction. Removing or demoting the last OWNER fails.
//
// Text limits (D-023): name 120, venue 200, description 5,000 characters (VarChar).
//
// CHECK constraints (migration SQL, D-010):
// - events_name_not_blank:            name has at least one non-space character.
// - events_capacity_positive:         capacity is NULL or greater than 0.
// - events_expected_attendees_nonneg: expectedAttendees is 0 or more.
// - events_ends_not_before_start:     endsAt is NULL or not earlier than startsAt.
// - events_last_attendee_number_nonneg: lastAttendeeNumber is 0 or more.
// - events_last_supplier_number_nonneg: lastSupplierNumber is 0 or more.
// - events_last_quote_number_nonneg: lastQuoteNumber is 0 or more.
// - events_last_payment_number_nonneg: lastPaymentNumber is 0 or more.
model Event {
  id                 String      @id @default(uuid()) @db.Uuid
  // Human-readable ID, for example EVT-2026-0001. Issued from EventReferenceCounter inside the
  // creating transaction (D-005). The unique index is the last line of defence against a duplicate.
  reference          String      @unique
  name               String      @db.VarChar(120)
  description        String?     @db.VarChar(5000)
  venue              String?     @db.VarChar(200)
  startsAt           DateTime
  endsAt             DateTime?
  // Venue capacity. Compared with expectedAttendees by the seating rule.
  capacity           Int?
  // Planning number. Not the count of attendee records. Changing it produces estimates.
  expectedAttendees  Int         @default(0)
  status             EventStatus @default(DRAFT)
  // Last attendee number issued in this event (ATT-0001, ...). Incremented atomically by the
  // create-attendee use case, in the same transaction as the insert, with raw SQL so updatedAt
  // (the edit version, D-032) does not move. Numbers are never reused (D-042).
  lastAttendeeNumber Int         @default(0)
  // Last supplier number issued in this event (SUP-0001, ...). Same rules as lastAttendeeNumber
  // (D-068).
  lastSupplierNumber Int         @default(0)
  // Last quote number issued in this event (QUO-0001, ...). Same rules as lastAttendeeNumber
  // (D-075).
  lastQuoteNumber    Int         @default(0)
  // Last supplier payment number issued in this event (PAY-0001, ...). Same rules as
  // lastAttendeeNumber (D-077).
  lastPaymentNumber  Int         @default(0)
  // Last budget item number issued in this event (BUD-0001, ...). Same rules as
  // lastAttendeeNumber (D-085).
  lastBudgetItemNumber Int       @default(0)
  // Restrict: a user who created events cannot be deleted while those events exist (D-011).
  createdById        String      @db.Uuid
  createdAt          DateTime    @default(now())
  // Set by Prisma on every update through the client. Raw SQL updates must set it themselves.
  updatedAt          DateTime    @updatedAt

  createdBy                 User                       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members                   EventMember[]
  auditLogs                 AuditLog[]
  attendees                 Attendee[]
  accessibilityRequirements AccessibilityRequirement[]
  accessibilityResources    AccessibilityResource[]
  suppliers                 Supplier[]
  supplierQuotes            SupplierQuote[]
  supplierPayments          SupplierPayment[]
  budgetCategories          BudgetCategory[]
  budgetItems               BudgetItem[]

  @@index([createdById])
  @@index([status, startsAt])
  @@map("events")
}

// Sequence behind the readable event ID (EVT-<year>-<number>). One row per year, incremented
// atomically by the create-event use case in the same transaction as the insert. The year is the
// creation year in Asia/Manila. See docs/DECISIONS.md, D-005.
model EventReferenceCounter {
  year       Int      @id
  // Last number issued for this year. The next event gets lastNumber + 1.
  lastNumber Int
  updatedAt  DateTime @updatedAt

  @@map("event_reference_counters")
}

// Changes that would leave an event without an OWNER fail at commit (D-022).
model EventMember {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per event.
  @@unique([eventId, userId])
  // Target of composite foreign keys from event-owned tables (D-002), for example task assignees.
  @@unique([eventId, id])
  @@index([userId])
  @@map("event_members")
}

// ─────────────────────────── Attendees ───────────────────────────

// A guest of one event (B2-01, D-042). Belongs to exactly one event and is deleted with it (D-004).
// Readable ID: ATT-<number>, numbered per event from Event.lastAttendeeNumber.
//
// Text limits: name 120, email 254, phone 32, category 60, dietary needs 500, notes 2,000.
// Duplicates are allowed: families share emails and two guests can share a name.
//
// CHECK constraints (migration 20261012120000_attendees):
// - attendees_name_not_blank:        name has at least one non-space character.
// - attendees_number_positive:       number is 1 or more.
// - attendees_plus_ones_range:       plusOnes is from 0 to 10.
// - attendees_optional_text_not_blank: email, phone, category, dietaryNeeds and notes are NULL or
//   have a non-space character (empty means NULL).
model Attendee {
  id           String     @id @default(uuid()) @db.Uuid
  eventId      String     @db.Uuid
  // Per-event sequence behind the readable ID, for example ATT-0184.
  number       Int
  name         String     @db.VarChar(120)
  // Stored trimmed and lower case.
  email        String?    @db.VarChar(254)
  phone        String?    @db.VarChar(32)
  // Free text, for example "Family" or "Colleagues".
  category     String?    @db.VarChar(60)
  rsvpStatus   RsvpStatus
  // How many guests come with this attendee, 0 to 10 (D-042). How they count toward live
  // attendance is decided with the attendance count (DECISIONS.md open item 4).
  plusOnes     Int
  dietaryNeeds String?    @db.VarChar(500)
  notes        String?    @db.VarChar(2000)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  event                     Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accessibilityRequirements AccessibilityRequirement[]

  @@unique([eventId, number])
  // Target of composite foreign keys from event-owned tables (D-002), for example accessibility
  // requirements.
  @@unique([eventId, id])
  @@index([eventId, name])
  @@index([eventId, rsvpStatus])
  @@map("attendees")
}

// ───────────────────────── Accessibility ─────────────────────────

// One need of one attendee (B3-01, D-056). An attendee has at most one requirement of each type;
// several needs are several rows. Belongs to the attendee through a composite foreign key on
// (eventId, attendeeId), so it can never point at another event's attendee (D-002), and is deleted
// with the attendee (D-045) or the event (D-004).
//
// The note may hold health details: it is loaded only for roles with accessibility.private (D-058).
//
// CHECK constraints (migration SQL):
// - accessibility_requirements_note_not_blank: note is NULL or has content.
// - accessibility_requirements_other_has_note: an OTHER requirement always has a note.
model AccessibilityRequirement {
  id         String                       @id @default(uuid()) @db.Uuid
  eventId    String                       @db.Uuid
  attendeeId String                       @db.Uuid
  type       AccessibilityRequirementType
  priority   RequirementPriority
  note       String?                      @db.VarChar(500)
  createdAt  DateTime                     @default(now())
  // Edit version: a save carrying an older value is refused as stale (D-032).
  updatedAt  DateTime                     @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee Attendee @relation(fields: [eventId, attendeeId], references: [eventId, id], onDelete: Cascade)

  @@unique([eventId, attendeeId, type])
  @@unique([eventId, id])
  // For counting needs by type across the event (readiness, later in Batch 3).
  @@index([eventId, type])
  @@map("accessibility_requirements")
}

// What the event provides for one resource type (B3-01, D-056). At most one row per type per event;
// no row means "Not set up". Only ACCESSIBLE_SEATS has a quantity.
//
// CHECK constraints (migration SQL):
// - accessibility_resources_quantity_rule: quantity is set (0 or more) for ACCESSIBLE_SEATS and
//   NULL for every other type.
// - accessibility_resources_note_not_blank: note is NULL or has content.
model AccessibilityResource {
  id        String                    @id @default(uuid()) @db.Uuid
  eventId   String                    @db.Uuid
  type      AccessibilityResourceType
  status    ResourceStatus
  quantity  Int?
  note      String?                   @db.VarChar(500)
  createdAt DateTime                  @default(now())
  // Edit version (D-032).
  updatedAt DateTime                  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, type])
  @@unique([eventId, id])
  @@map("accessibility_resources")
}

// ─────────────────────────── Audit log ───────────────────────────

// Append-only record of meaningful changes inside an event (B1-11, D-037). Only actions in the audit
// registry (src/modules/events/audit/actions.ts) are written, each with validated details, in the
// same transaction as the change. See docs/AUDIT.md.
//
// Trigger audit_logs_append_only (migration 20261012090000_audit_log) rejects direct UPDATE and
// DELETE. Rows still go when their event is deleted (D-004), and actorId becomes NULL if the user is
// deleted.
//
// CHECK constraints (same migration):
// - audit_logs_action_format: action looks like "<entity>.<verb>", lower case.
// - audit_logs_entity_pair:   entityType and entityId are both set or both NULL.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  // Who made the change. NULL only if that user has since been deleted.
  actorId    String?  @db.Uuid
  // For example "event.updated". Only actions in the audit registry.
  action     String   @db.VarChar(64)
  // The record the action is about, where there is one, for example "event" and its id.
  entityType String?  @db.VarChar(64)
  entityId   String?  @db.Uuid
  // Action-specific details, validated by the registry on write and read. Never personal data
  // beyond what the action needs (docs/AUDIT.md).
  details    Json?
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([eventId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ─────────────────────────── Suppliers ───────────────────────────

// What a supplier provides (B4-01, B4-02; D-068, D-069). The labels and meanings live in
// src/modules/events/suppliers/categories.ts; tests keep the two lists equal.
enum SupplierCategory {
  VENUE
  CATERING
  CAKE_AND_DESSERTS
  PHOTO_AND_VIDEO
  SOUND_AND_LIGHTS
  ENTERTAINMENT
  FLOWERS_AND_STYLING
  HAIR_AND_MAKEUP
  ATTIRE
  RENTALS
  TRANSPORT
  PRINTING_AND_STATIONERY
  OTHER

  @@map("supplier_category")
}

// A supplier of one event (B4-01, D-068). Strictly event-specific: belongs to exactly one event and
// is deleted with it (D-004); nothing is shared between events. Readable ID: SUP-<number>, numbered
// per event from Event.lastSupplierNumber and never reused.
//
// Text limits: name 120, category detail 60, contact name 120, email 254, phone 32, notes 2,000.
// Duplicate names are allowed (D-068): the number tells two suppliers apart.
// Quotes are SupplierQuote rows (D-075); deposits and payments with their due dates are
// SupplierPayment rows (D-077), following D-003.
//
// CHECK constraints (migration 20261014090000_suppliers):
// - suppliers_name_not_blank:          name has at least one non-space character.
// - suppliers_number_positive:         number is 1 or more.
// - suppliers_category_detail:         categoryDetail is set (non-blank) for OTHER and NULL for
//                                      every other category (D-069).
// - suppliers_optional_text_not_blank: contactName, email, phone and notes are NULL or have a
//                                      non-space character (empty means NULL).
model Supplier {
  id             String           @id @default(uuid()) @db.Uuid
  eventId        String           @db.Uuid
  // Per-event sequence behind the readable ID, for example SUP-0012.
  number         Int
  name           String           @db.VarChar(120)
  category       SupplierCategory
  // What the supplier provides when the category is Other, for example "Fireworks".
  categoryDetail String?          @db.VarChar(60)
  // The person to talk to at the supplier.
  contactName    String?          @db.VarChar(120)
  // Stored trimmed and lower case.
  email          String?          @db.VarChar(254)
  phone          String?          @db.VarChar(32)
  notes          String?          @db.VarChar(2000)
  createdAt      DateTime         @default(now())
  // Edit version: a save carrying an older value is refused as stale (D-032).
  updatedAt      DateTime         @updatedAt

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quotes   SupplierQuote[]
  payments SupplierPayment[]

  @@unique([eventId, number])
  // Target of composite foreign keys from event-owned tables (D-002): quotes, payments, and later
  // budget lines and tasks.
  @@unique([eventId, id])
  @@index([eventId, name])
  @@index([eventId, category])
  @@map("suppliers")
}

// Where a supplier quote stands (B4-11, D-076). Pending: received, no decision yet. Accepted: the
// organizer took it; its amount is what is committed to the supplier (D-003). Declined: not taken.
// At most one Accepted quote per supplier, checked by the quote use cases (D-075).
enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("quote_status")
}

// A price a supplier quoted for one event (B4-08, D-075). Belongs to one supplier of one event: the
// composite foreign key (eventId, supplierId) keeps both in the same event (D-002), and quotes are
// deleted with their supplier (D-072). Readable ID: QUO-<number>, numbered per event from
// Event.lastQuoteNumber and never reused.
//
// Money (D-075): amount in Philippine pesos (no currency column), exactly two decimal places,
// Decimal(12, 2), never floating point; more than ₱0.00 and at most ₱9,999,999,999.99.
//
// CHECK constraints (migration 20261014120000_supplier_quotes):
// - supplier_quotes_amount_positive:       amount is more than 0.
// - supplier_quotes_number_positive:       number is 1 or more.
// - supplier_quotes_description_not_blank: description is NULL or has a non-space character.
model SupplierQuote {
  id              String      @id @default(uuid()) @db.Uuid
  eventId         String      @db.Uuid
  supplierId      String      @db.Uuid
  // Per-event sequence behind the readable ID, for example QUO-0003.
  number          Int
  // Optional short label to tell a supplier's quotes apart, for example "Package B, 200 guests".
  description     String?     @db.VarChar(120)
  amount          Decimal     @db.Decimal(12, 2)
  status          QuoteStatus @default(PENDING)
  // When the status last changed (set on create and on every status change).
  statusChangedAt DateTime    @default(now())
  createdAt       DateTime    @default(now())
  // Edit version: a save carrying an older value is refused as stale (D-032).
  updatedAt       DateTime    @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [eventId, supplierId], references: [eventId, id], onDelete: Cascade)

  @@unique([eventId, number])
  @@unique([eventId, id])
  // A supplier's quotes, and finding its accepted one.
  @@index([eventId, supplierId, status])
  @@map("supplier_quotes")
}

// What a supplier payment is for (B4-12, D-077). A deposit secures the booking; any other
// scheduled payment (a balance or an instalment) is a payment.
enum PaymentKind {
  DEPOSIT
  PAYMENT

  @@map("payment_kind")
}

// What is recorded about a supplier payment (B4-12, D-077): it has been paid, or not yet. Whether an
// unpaid payment is upcoming, due today or overdue is calculated from its due date, never stored
// (D-079).
enum PaymentRecordStatus {
  UNPAID
  PAID

  @@map("payment_record_status")
}

// A payment owed to a supplier of one event (B4-12, D-077): status tracking only, never payment
// processing. Belongs to one supplier of one event through the composite foreign key
// (eventId, supplierId) (D-002) and is deleted with its supplier (D-072). Readable ID:
// PAY-<number>, numbered per event from Event.lastPaymentNumber and never reused.
//
// Money as quotes (D-075): pesos, Decimal(12, 2), more than ₱0.00. Dates are calendar dates in
// Philippine time (D-025, D-079), stored as DATE with no time.
//
// CHECK constraints (migration 20261014150000_supplier_payments):
// - supplier_payments_amount_positive:       amount is more than 0.
// - supplier_payments_number_positive:       number is 1 or more.
// - supplier_payments_description_not_blank: description is NULL or has a non-space character.
// - supplier_payments_paid_on_rule:          paidOn is set for PAID and NULL for UNPAID.
// - supplier_payments_dates_in_range:        dueDate and paidOn are from 2000-01-01 to 2100-12-31.
model SupplierPayment {
  id          String              @id @default(uuid()) @db.Uuid
  eventId     String              @db.Uuid
  supplierId  String              @db.Uuid
  // Per-event sequence behind the readable ID, for example PAY-0002.
  number      Int
  kind        PaymentKind
  // Optional short label, for example "50% downpayment".
  description String?             @db.VarChar(120)
  amount      Decimal             @db.Decimal(12, 2)
  dueDate     DateTime            @db.Date
  status      PaymentRecordStatus @default(UNPAID)
  // The day it was paid; set only when status is PAID.
  paidOn      DateTime?           @db.Date
  createdAt   DateTime            @default(now())
  // Edit version: a save carrying an older value is refused as stale (D-032).
  updatedAt   DateTime            @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [eventId, supplierId], references: [eventId, id], onDelete: Cascade)

  @@unique([eventId, number])
  @@unique([eventId, id])
  // A supplier's payments, by due date.
  @@index([eventId, supplierId, dueDate])
  // Unpaid payments across the event by due date (overdue checks, the supplier list).
  @@index([eventId, status, dueDate])
  @@map("supplier_payments")
}

// ─────────────────────────── Budget ───────────────────────────

// A named group of budget items with one allocation (B5-F01, D-084). Belongs to exactly one event
// and is deleted with it (D-004). A category with items cannot be deleted: the use case checks
// first and the foreign key from budget_items (NO ACTION) backs it up.
//
// Nothing derived is stored: no totals, no remaining amount, no status (PROJECT_RULES section 6).
//
// CHECK constraints and one index Prisma cannot express (migration 20261015090000_budget):
// - budget_categories_eventId_name_lower_key: unique (eventId, lower(name)), so two categories of
//                                       one event can't differ only by letter case (D-084).
// - budget_categories_name_not_blank: name has at least one non-space character.
// - budget_categories_allocation_nonneg: allocationAmount is 0 or more.
model BudgetCategory {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @db.Uuid
  name             String   @db.VarChar(120)
  // Pesos set aside for the category: a planning number the user enters, never derived. 0 or more.
  allocationAmount Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  // Edit version: a save carrying an older value is refused as stale (D-032).
  updatedAt        DateTime @updatedAt

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items BudgetItem[]

  // Target of the composite foreign key from budget_items (D-002).
  @@unique([eventId, id])
  @@map("budget_categories")
}

// One planned cost of the event (B5-F02, D-085), inside exactly one category. Readable ID:
// BUD-<number>, numbered per event from Event.lastBudgetItemNumber. Committed and paid are entered
// by the user. Linking an item to a supplier (D-003) is a later task: it will make both columns
// optional and add supplierId in its own migration.
//
// CHECK constraints (migration 20261015090000_budget):
// - budget_items_number_positive:   number is 1 or more.
// - budget_items_name_not_blank:    name has at least one non-space character.
// - budget_items_notes_not_blank:   notes is NULL or has a non-space character.
// - budget_items_estimated_nonneg, budget_items_committed_nonneg, budget_items_paid_nonneg:
//                                   each amount is 0 or more.
model BudgetItem {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @db.Uuid
  categoryId      String   @db.Uuid
  // Per-event sequence behind the readable ID, for example BUD-0004.
  number          Int
  name            String   @db.VarChar(120)
  // What the item is expected to cost: the plan.
  estimatedAmount Decimal  @db.Decimal(12, 2)
  // Money the event is obliged to pay, and money recorded as paid.
  committedAmount Decimal  @db.Decimal(12, 2)
  paidAmount      Decimal  @db.Decimal(12, 2)
  notes           String?  @db.VarChar(2000)
  createdAt       DateTime @default(now())
  // Edit version: a save carrying an older value is refused as stale (D-032).
  updatedAt       DateTime @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // NO ACTION, not RESTRICT: when an event is deleted its categories and items go in one statement,
  // and RESTRICT could refuse that. NO ACTION is checked at the end of the statement (D-002).
  category BudgetCategory @relation(fields: [eventId, categoryId], references: [eventId, id], onDelete: NoAction)

  @@unique([eventId, number])
  @@unique([eventId, id])
  // An event's items by category: the category list and the "category has items" check.
  @@index([eventId, categoryId])
  @@map("budget_items")
}
